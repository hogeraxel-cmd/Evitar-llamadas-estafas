{
  "name": "alo-seguro-firebase",
  "private": true,
  "description": "Etapa 2: reglas de seguridad y pruebas contra el emulador de Firebase. Ver ../docs/PLAN-FIREBASE.md",
  "type": "module",
  "scripts": {
    "emuladores": "firebase emulators:start --project demo-alo-seguro",
    "test": "firebase emulators:exec --only firestore --project demo-alo-seguro \"node --test --test-concurrency=1 test/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  }
}
